# 1. Imagem oficial do Python (usaremos a 3.12 slim, que é leve e segura)
FROM python:3.12-slim

# 2. Configurações de ambiente para o Python rodar melhor no Docker
# Não cria arquivos temporários .pyc
ENV PYTHONDONTWRITEBYTECODE=1 
# Joga os logs do FastAPI direto para o terminal do Docker (não atrasa o print)
ENV PYTHONUNBUFFERED=1

# 3. Define a pasta onde tudo vai acontecer dentro do container
WORKDIR /app

# 4. Copia APENAS o requirements.txt primeiro
COPY requirements.txt .

# 5. Instala as bibliotecas da API
# Se você usar psycopg2 (sem o -binary), talvez precise instalar as ferramentas de compilação C do Linux. 
# Caso dê erro, mude no requirements de psycopg2 para psycopg2-binary
RUN pip install --no-cache-dir -r requirements.txt

# 6. Copia todo o código-fonte da sua API (routers, crud, main.py...) para o container
COPY . .

# 7. Expõe a porta 8000 para se comunicar com o docker-compose
EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]